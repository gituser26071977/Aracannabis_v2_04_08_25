      { "type": "inhale", "durationMs": 4000, "curve": "ease-in-out" },
      { "type": "hold-in", "durationMs": 7000, "curve": "linear" },
      { "type": "exhale", "durationMs": 8000, "curve": "ease-in-out" }
    ]
  },
