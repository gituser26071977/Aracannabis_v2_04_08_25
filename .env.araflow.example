# ================================================================
# AraFlow — RC1 Environment Template
# COPIE para .env.araflow e preencha com valores próprios.
#
# Este arquivo controla o `docker-compose.araflow.yml` (RC1 internal
# beta em https://flow.arapath.com.br). NÃO afeta o AraOS em
# produção — araflow* usa rede Docker `web` externa + labels Traefik
# próprias (prefixo `araflow-*`).
#
# Imagens: GHCR público `ghcr.io/gituser26071977/araflow-{api,web}`.
# ================================================================

# ---- Domínio público ----
FLOW_DOMAIN=flow.arapath.com.br

# ---- Imagens (registry GHCR) ----
ARAFLOW_API_IMAGE=ghcr.io/gituser26071977/araflow-api
ARAFLOW_WEB_IMAGE=ghcr.io/gituser26071977/araflow-web
# Tag pinada pela CI. Em rollback basta alterar este valor e
# `docker compose -f docker-compose.araflow.yml pull && up -d`.
# IMPORTANTE: prefixado `ARAFLOW_` para não colidir com `IMAGE_TAG`
# usado em docker-compose.prod.yml do AraOS.
ARAFLOW_IMAGE_TAG=rc1-latest

# ---- Runtime API ----
NODE_ENV=production
PORT=5005
LOG_LEVEL=info

# ---- Build metadata (forwarded para o /health response) ----
# Em produção, a CI popula via `--build-arg`; aqui ficam apenas como
# fallback caso se rode `docker compose build` localmente.
GIT_COMMIT=unknown
BUILD_TIME=unknown
ARAFLOW_VERSION=1.0.0

# ---- Operação ----
RESTART_POLICY=unless-stopped
# Limite de log por container (10 MB × 3 arquivos = 30 MB por serviço).
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3