# ============================================
# SIAP - Variáveis de Ambiente (EXEMPLO)
# ============================================
# ATENÇÃO: Este é um arquivo de EXEMPLO
# NÃO commitar o arquivo .env real no Git!
# Copie este arquivo para .env e preencha com valores reais
# ============================================

# REDACTED
# 1. AMBIENTE E DEBUG
# REDACTED
FLASK_ENV=production
FLASK_APP=app_cors_livre.py
DEBUG=False
FRONTEND_BASE_URL=https://seu-dominio.com

# REDACTED
# 2. DATABASE
# REDACTED
# Produção (Docker): postgresql://user:pass@host:5432/dbname
# Desenvolvimento local: sqlite:///araos.db
DATABASE_URL=postgresql://siap_user:CHANGE_ME@siap-db:5432/siap_db

# REDACTED
# 3. SEGURANÇA - SECRETS (OBRIGATÓRIOS!)
# REDACTED
# CRÍTICO: Gerar com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_32_CHARS
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_32_CHARS

# Webhook WhatsApp (OBRIGATÓRIO para produção)
# Gerar com mesmo comando acima
WEBHOOK_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_32_CHARS
WEBHOOK_MAX_REQUESTS_PER_MINUTE=10
# WEBHOOK_IP_WHITELIST=1.2.3.4,5.6.7.8  # Opcional

# REDACTED
# 4. EMAIL (SMTP)
# REDACTED
SMTP_SERVER=smtp.exemplo.com
SMTP_PORT=465
SMTP_USERNAME=seu-email@exemplo.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_USE_SSL=True
SMTP_USE_TLS=False
EMAIL_FROM=noreply@exemplo.com
EMAIL_FROM_NAME=SIAP Sistema
EMAIL_DEVELOPMENT_MODE=False

# REDACTED
# 5. TELEGRAM (OPCIONAL — substitui WhatsApp/Evolution em D05k)
# REDACTED
# Default bot token (Dr. Anderson) — usado para admin notif.
TELEGRAM_DEFAULT_BOT_TOKEN=
# Chat ID do admin (Dr. Anderson) que recebe as notificações.
TELEGRAM_ADMIN_CHAT_ID=
# Multi-tenant per-clinic bot tokens sao armazenados em ConfiguracaoIA
# (campos telegram_bot_token + telegram_webhook_secret). Não declare aqui.

# REDACTED
# 6. LLMs - CONFIGURAÇÃO PADRÃO
# REDACTED
DEFAULT_LLM_PROVIDER=ollama_local
DEFAULT_LLM_MODEL=gemma3:4b
DEFAULT_LLM_VISION_PROVIDER=deepseek
DEFAULT_LLM_VISION_MODEL=deepseek-chat
DEFAULT_LLM_MULTIMODAL_PROVIDER=deepseek
DEFAULT_LLM_MULTIMODAL_MODEL=deepseek-chat

# REDACTED
# 7. LLMs - CHAVES DE API
# REDACTED
# OpenAI (GPT-4, GPT-3.5)
# OPENAI_API_KEY=sk-proj-...
# OPENAI_TIMEOUT=120

# Groq (Llama, Mixtral - rápido e gratuito)
# GROQ_API_KEY=gsk_...
# GROQ_TIMEOUT=60

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_TIMEOUT=120

# Google (Gemini)
# GOOGLE_API_KEY=AIza...
# GOOGLE_TIMEOUT=60

# DeepSeek (econômico)
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# xAI (Grok)
# XAI_API_KEY=xai-...
# XAI_BASE_URL=https://api.x.ai/v1

# REDACTED
# 8. OLLAMA (LOCAL E CLOUD)
# REDACTED
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# OLLAMA_CLOUD_URL=https://sua-instancia-ollama.com
# OLLAMA_API_KEY=

# REDACTED
# 9. TIMEOUTS
# REDACTED
CREWAI_TIMEOUT=300

# REDACTED
# 10. MERCADO PAGO (OPCIONAL - BILLING)
# REDACTED
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# MERCADOPAGO_PUBLIC_KEY=APP_USR-...

# REDACTED
# 11. WEBHOOK SECRETS (P0-A FASE 4 — OBRIGATORIO em producao)
# REDACTED
# Gerar com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MERCADOPAGO_WEBHOOK_SECRET=CHANGE_ME_GENERATE_RANDOM_32_CHARS
MERCADOPAGO_MODULOS_WEBHOOK_SECRET=CHANGE_ME_GENERATE_RANDOM_32_CHARS
DR_ANDERSON_WEBHOOK_SECRET=CHANGE_ME_GENERATE_RANDOM_32_CHARS

# Chave de servico interno (Dr. Anderson Agent → SIAP)
INTERNAL_SERVICE_KEY=CHANGE_ME_GENERATE_RANDOM_32_CHARS

# D05k — Telegram Bot API (substitui Evolution API / WhatsApp)
# Bot fixo do Dr. Anderson para admin notif (notify_admin_new_registration,
# notify_doctor_approval). Provisione o bot via @BotFather e cole o token.
TELEGRAM_DEFAULT_BOT_TOKEN=REDACTED
TELEGRAM_ADMIN_CHAT_ID=CHANGE_ME_TELEGRAM_ADMIN_CHAT_ID

# Webhook header validation para o bot dedicado do Dr. Anderson.
# Setado via setWebhook secret_token=<valor>. Compare_digest em runtime.
# (Multi-tenant: cada clínica tem o seu próprio TELEGRAM_BOT_TOKEN_<SLUG>
#  armazenado em ConfiguracaoIA — não precisa declarar aqui.)

# Permite simulate=true em /api/modulos/webhook (DEV ONLY — sempre 0 em prod)
ALLOW_WEBHOOK_SIMULATION=0

# REDACTED
# 12. RATE LIMITING (FASE 5A)
# REDACTED
# Flask-Limiter usa Redis para compartilhar contadores entre os 3 gunicorn workers.
# Se REDIS_URL não for definido, fallback automático para memory:// (NÃO recomendado em prod).
# Se RATELIMIT_STORAGE_URL for definido, ele tem prioridade absoluta.
# RATELIMIT_STORAGE_URL=redis://localhost:6379/1
RATE_LIMIT_REDIS_DB=1

# REDACTED
# VALIDAÇÃO
# REDACTED
# Execute para validar configuração:
# python3 scripts/validate_env.py

# Certificação Digital (Bird ID / CESS) — credenciais corporativas da Soluti
BIRD_ID_CLIENT_ID=troque-pelo-client-id-corporativo
BIRD_ID_CLIENT_SECRET=REDACTED
BIRD_ID_BASE_URL=https://cess.lab.vaultid.com.br
