# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aracannabis

# Security Keys (Change these in production!)
JWT_SECRET_KEY=REDACTED
SECRET_KEY=REDACTED

# Debug Mode (set to False in production)
DEBUG=True

# Email Configuration (Hostinger SMTP)
SMTP_SERVER=smtp.hostinger.com
SMTP_PORT=465
EMAIL_USER=aracannabis@agentesinteligentes.pro
EMAIL_PASSWORD=sua_senha_aqui

# WhatsApp Configuration (Optional - configure with your preferred API)
WHATSAPP_API_URL=https://api.twilio.com/2010-04-01/Accounts/YOUR_SID/Messages.json
WHATSAPP_TOKEN=your_whatsapp_api_token_here

# OpenAI API Key (Required for AI features)
OPENAI_API_KEY=REDACTED

# Groq API Key (Alternative for AI features)
GROQ_API_KEY=GROQ_KEY_REDACTED

# Ollama Configuration (for local LLMs)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b # Alterado para gemma3:4b

# Default LLM Provider for AI features (ollama, groq, openai)
DEFAULT_LLM_PROVIDER=ollama
