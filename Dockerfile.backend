# Dockerfile para o backend Flask
FROM python:3.9-slim

WORKDIR /app

# Instalar dependências do sistema incluindo Tesseract OCR
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    tesseract-ocr \
    tesseract-ocr-por \
    tesseract-ocr-eng \
    libtesseract-dev \
    libleptonica-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copiar arquivos de requisitos e instalar dependências Python
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir --retries 5 --timeout 60 -r requirements.txt

# Copiar o restante do código da aplicação
COPY . .

# Criar diretório de uploads
RUN mkdir -p uploads/exames

# Expor a porta que a aplicação Flask usa
EXPOSE 5004

# Comando para rodar a aplicação
CMD ["python", "app_cors_livre.py", "--port", "5004"]
