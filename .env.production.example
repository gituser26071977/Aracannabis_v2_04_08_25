# ============================================================
# VisualSmartFlow Platform — AraOS Production Configuration
# Hostinger VPS - Docker Deployment
# ============================================================

# REDACTED
# 1. CONFIGURAÇÕES FLASK (Obrigatório)
# REDACTED
FLASK_APP=app_cors_livre.py
FLASK_ENV=production
DEBUG=False

# Chaves secretas - GERAR VALORES ÚNICOS E FORTES!
# Use: openssl rand -hex 32
SECRET_KEY=REDACTED
JWT_SECRET_KEY=REDACTED

# REDACTED
# 2. BANCO DE DADOS PostgreSQL (Obrigatório)
# REDACTED
POSTGRES_DB=araos
POSTGRES_USER=siap_user
# SENHA FORTE OBRIGATÓRIA! Mínimo 16 caracteres, misture letras, números e símbolos
POSTGRES_PASSWORD=REDACTED

# URL completa do banco (gerada automaticamente no docker-compose)
# DATABASE_URL=postgresql://araos_user:${POSTGRES_PASSWORD}@araos-db:5432/araos

# REDACTED
# 3. URLS E DOMÍNIOS (Obrigatório)
# REDACTED
FRONTEND_BASE_URL=https://araos.visualsmartflow.com.br
API_BASE_URL=https://api.visualsmartflow.com.br
CORS_ORIGINS=https://araos.visualsmartflow.com.br,https://visualsmartflow.com.br,https://app.visualsmartflow.com.br

# REDACTED
# 4. PROVEDORES DE IA / LLM (Recomendado)
# REDACTED
# Provedor padrão para chat
DEFAULT_LLM_PROVIDER=google
DEFAULT_LLM_MODEL=gemini-2.5-flash-lite

# Provedor para visão/análise de imagens
DEFAULT_LLM_VISION_PROVIDER=google
DEFAULT_LLM_VISION_MODEL=gemini-2.5-flash-lite

# Provedor para multimodal
DEFAULT_LLM_MULTIMODAL_PROVIDER=google
DEFAULT_LLM_MULTIMODAL_MODEL=gemini-2.5-flash-lite

# REDACTED
# 5. CHAVES DE API DE IA (Preencher pelo menos um)
# REDACTED
# Google Gemini (Recomendado - tem free tier generoso)
GOOGLE_API_KEY=sua_chave_google_ai_studio_aqui

# Maritaca AI (Alternativa brasileira)
MARITACA_API_KEY=

# OpenAI (GPT-4, GPT-3.5)
OPENAI_API_KEY=

# Groq (rápido e barato)
GROQ_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Zhipu (GLM models)
ZHIPU_API_KEY=

# REDACTED
# 6. OLLAMA (IA Local - Opcional)
# REDACTED
# Se você tem Ollama rodando no host
OLLAMA_BASE_URL=http://host.docker.internal:11434

# REDACTED
# 7. SERVIÇO DE EMAIL (Opcional mas recomendado)
# REDACTED
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app
SMTP_FROM=AraOS <seu_email@gmail.com>
SMTP_TLS=true

# REDACTED
# 8. ANONIMIZAÇÃO LGPD (Opcional)
# REDACTED
ANONYMIZATION_KEY=REDACTED
ANONYMIZATION_AUDIT_MODEL=qwen3:1.7b

# REDACTED
# 9. PAGAMENTOS - Mercado Pago (Opcional)
# REDACTED
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# REDACTED
# 10. CONFIGURAÇÕES DE SEGURANÇA
# REDACTED
# Desativar telemetria
OTEL_SDK_DISABLED=true
CREWAI_DISABLE_TELEMETRY=true
CREWAI_DISABLE_TRACKING=true

# FASE 5A — Rate limiting (Flask-Limiter)
# Se RATELIMIT_STORAGE_URL não for definido, o sistema usa REDIS_URL + RATE_LIMIT_REDIS_DB.
# Redis é compartilhado entre os 3 gunicorn workers — contador único, sem race condition.
# Em ambiente multi-container isso é CRÍTICO.
# Para usar memória local (NÃO recomendado em prod multi-worker), defina:
# RATELIMIT_STORAGE_URL=memory://
# (sem a linha abaixo o sistema deriva o storage_uri a partir de REDIS_URL)

# Database Redis dedicado para rate limit (não conflita com cache /0 usado pelos demais serviços)
RATE_LIMIT_REDIS_DB=1

# REDACTED
# 11. REDIS (Cache - Opcional, usa memória se não definido)
# REDACTED
REDIS_URL=redis://siap-redis:6379/0

# REDACTED
# 12. UPLOADS E ARQUIVOS
# REDACTED
MAX_CONTENT_LENGTH=52428800  # 50MB em bytes
UPLOAD_FOLDER=/app/uploads

# ============================================================
# INSTRUÇÕES DE SEGURANÇA:
# ============================================================
# 1. NUNCA comite este arquivo com valores reais!
# 2. Gere SECRET_KEY e JWT_SECRET_KEY únicos para produção
# 3. Use senhas fortes para o banco de dados
# 4. Proteja as chaves de API como segredos
# 5. Faça backup regular do arquivo .env.production
# ============================================================
