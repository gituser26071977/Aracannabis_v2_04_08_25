{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://araflow.app/schemas/protocol.schema.json",
  "title": "AraFlow Protocol",
  "description": "Schema canônico de um protocolo de respiração",
  "type": "object",
  "required": ["id", "version", "title", "evidenceLevel", "phases", "durationMs", "cycles"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Identificador único do protocolo"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Versão semântica"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "subtitle": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "evidenceLevel": {
      "type": "string",
      "enum": ["A", "B", "C", "D"]
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "cycles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "restBetweenCyclesMs": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/phase" }
    },
    "audio": { "$ref": "#/$defs/audio" },
    "animation": { "$ref": "#/$defs/animation" },
    "contraindications": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "preconditions": { "$ref": "#/$defs/preconditions" },
    "metadata": { "$ref": "#/$defs/metadata" }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "required": ["type", "durationMs"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["inhale", "hold-in", "exhale", "hold-out"]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "curve": {
          "type": "string",
          "enum": ["linear", "ease-in", "ease-out", "ease-in-out"],
          "default": "ease-in-out"
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "introVoiceId": { "type": "string" },
        "cueVoiceId": { "type": "string" },
        "ambientTrackId": { "type": "string" },
        "volumeCurve": {
          "type": "string",
          "enum": ["constant", "fade-in", "fade-out", "fade-in-out"],
          "default": "constant"
        },
        "enableEndCue": { "type": "boolean", "default": true }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {
          "type": "string",
          "enum": ["circle", "wave", "square"],
          "default": "circle"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "showPhaseLabel": { "type": "boolean", "default": true },
        "showCountdown": { "type": "boolean", "default": true }
      }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minAge": { "type": "integer", "minimum": 0 },
        "maxAge": { "type": "integer", "minimum": 0 },
        "excludeConditions": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["author", "approvedAt"],
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    }
  }
}
