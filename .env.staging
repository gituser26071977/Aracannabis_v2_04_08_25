# ================================================================
# AraOS — STAGING Environment Template
# COPIE para .env.staging e preencha com valores próprios.
# NUNCA reutilize secrets de prod.
# ================================================================

# Ambiente
ENVIRONMENT=staging
FLASK_ENV=staging

# Banco de Dados
POSTGRES_DB=aracannabis_staging
POSTGRES_USER=siap_staging
POSTGRES_PASSWORD=REDACTED

# Secrets (≥32 chars cada)
JWT_SECRET_KEY=REDACTED
SECRET_KEY=REDACTED
CSRF_TOKEN=REDACTED

# Webhooks
MERCADOPAGO_WEBHOOK_SECRET=GERE_32_CHARS_staging_mp
MERCADOPAGO_MODULOS_WEBHOOK_SECRET=GERE_32_CHARS_staging_mp_mod
EVOLUTION_WEBHOOK_SECRET=GERE_32_CHARS_staging_evo
DR_ANDERSON_WEBHOOK_SECRET=GERE_32_CHARS_staging_dra
INTERNAL_SERVICE_KEY=GERE_32_CHARS_staging_internal

# Anonimização (LGPD)
ANONYMIZATION_KEY=GERE_32_CHARS_staging_anon

# URLs (staging)
FRONTEND_BASE_URL=https://staging.visualsmartflow.com.br
API_BASE_URL=https://api.staging.visualsmartflow.com.br

# Integrações externas (use SANDBOX)
MERCADOPAGO_PUBLIC_KEY=APP_USR-staging-sandbox
MERCADOPAGO_ACCESS_TOKEN=APP_USR-staging-sandbox-token
MERCADOPAGO_SANDBOX=true

# Observabilidade
LOG_LEVEL=INFO
SENTRY_DSN=

# Para CI/smoke automatizado
ALLOW_SMOKE_TESTS=true
