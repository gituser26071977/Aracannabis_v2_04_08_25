{
  "name": "@araflow/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "AraFlow — Aplicativo mobile (iOS + Android) React Native",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "coverage": "jest --coverage",
    "lint": "eslint --max-warnings 0 \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"e2e/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"e2e/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\" \"__tests__/**/*.{ts,tsx}\" \"e2e/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\" \"__tests__/**/*.{ts,tsx}\" \"e2e/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace AraFlow.xcworkspace -scheme AraFlow -configuration Release -archivePath build/araflow.xcarchive archive",
    "build:tsc": "tsc --noEmit",
    "build:web": "webpack --config web/webpack.config.js --mode production",
    "build:web:dev": "webpack --config web/webpack.config.js --mode development",
    "web:dev": "webpack serve --config web/webpack.config.dev.js --mode development",
    "clean": "rm -rf node_modules build coverage web/dist android/build android/app/build ios/build",
    "postinstall": "patch-package || true"
  },
  "dependencies": {
    "@araflow/shared-contracts": "1.0.0",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "i18next": "^23.11.0",
    "react": "18.3.1",
    "react-i18next": "^14.1.0",
    "react-native": "0.74.1",
    "react-native-safe-area-context": "^4.10.1",
    "react-native-screens": "^3.31.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-env": "^7.24.4",
    "@babel/runtime": "^7.24.4",
    "@commitlint/cli": "^19.2.2",
    "@commitlint/config-conventional": "^19.1.2",
    "@react-native/babel-preset": "0.74.83",
    "@react-native/eslint-config": "0.74.83",
    "@react-native/metro-config": "0.74.83",
    "@react-native/typescript-config": "0.74.83",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.79",
    "@types/react-test-renderer": "^18.0.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "5.0.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "patch-package": "^8.0.0",
    "prettier": "^3.2.5",
    "react-test-renderer": "18.3.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5",
    "react-native-web": "^0.19.13",
    "react-dom": "18.3.1",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "babel-loader": "^9.1.3",
    "html-webpack-plugin": "^5.6.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "process": "^0.11.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "jest": {
    "preset": "react-native",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@core/(.*)$": "<rootDir>/src/core/$1",
      "^@features/(.*)$": "<rootDir>/src/features/$1",
      "^@shared/(.*)$": "<rootDir>/src/shared/$1",
      "^@infrastructure/(.*)$": "<rootDir>/src/infrastructure/$1",
      "^@contracts/(.*)$": "<rootDir>/../shared-contracts/src/$1",
      "^@araflow/shared-contracts$": "<rootDir>/../shared-contracts/src/index.ts",
      "^@araflow/shared-contracts/(.*)$": "<rootDir>/../shared-contracts/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@react-native|react-native|@react-navigation)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.stories.tsx",
      "!src/**/index.ts",
      "!src/**/*.types.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 85,
        "lines": 85,
        "statements": 85
      },
      "./src/core/runtime/": {
        "branches": 75,
        "functions": 90,
        "lines": 90,
        "statements": 90
      },
      "./src/core/execution-session/": {
        "branches": 85,
        "functions": 90,
        "lines": 90,
        "statements": 90
      },
      "./src/core/session-orchestrator/": {
        "branches": 80,
        "functions": 90,
        "lines": 90,
        "statements": 90
      },
      "./src/core/session-persistence/": {
        "branches": 80,
        "functions": 90,
        "lines": 90,
        "statements": 90
      },
      "./src/core/animation-engine/": {
        "branches": 90,
        "functions": 95,
        "lines": 95,
        "statements": 95
      },
      "./src/core/audio-engine/": {
        "branches": 90,
        "functions": 95,
        "lines": 95,
        "statements": 95
      },
      "./src/features/session/Clinical/": {
        "branches": 90,
        "functions": 95,
        "lines": 95,
        "statements": 95
      }
    },
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.{ts,tsx}",
      "<rootDir>/src/**/__tests__/**/*.test.{ts,tsx}",
      "<rootDir>/src/**/*.test.{ts,tsx}"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ]
  }
}
