# Configurações de IA para Aracannabis
# Copie este arquivo para .env e configure suas chaves de API

# ===== CONFIGURAÇÃO PRINCIPAL DE IA =====
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=llama-3.1-70b-versatile
DEFAULT_LLM_BASE_URL=https://api.groq.com/openai/v1

# ===== CHAVES DE API DOS PROVEDORES =====

# OpenAI (GPT-4, GPT-3.5, etc.)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Groq (Llama, Mixtral - RÁPIDO e GRATUITO)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=GROQ_KEY_REDACTED-groq-key-here

# Anthropic Claude (Claude 3.5 Sonnet)
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google Gemini
# Obtenha em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# xAI Grok
# Obtenha em: https://console.x.ai/
XAI_API_KEY=xai-your-xai-key-here

# ===== OLLAMA (LOCAL) =====
# Para usar modelos locais (privacidade máxima)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral-small3.1:24b

# ===== RECOMENDAÇÕES =====
# 
# PARA COMEÇAR (GRATUITO):
# 1. Crie conta no Groq: https://console.groq.com/
# 2. Obtenha API key gratuita
# 3. Configure GROQ_API_KEY acima
# 4. Use DEFAULT_LLM_PROVIDER=groq
#
# PARA MÁXIMA QUALIDADE:
# 1. Use OpenAI GPT-4o: DEFAULT_LLM_PROVIDER=openai, DEFAULT_LLM_MODEL=gpt-4o
# 2. Ou Claude 3.5 Sonnet: DEFAULT_LLM_PROVIDER=anthropic
#
# PARA PRIVACIDADE TOTAL:
# 1. Instale Ollama: https://ollama.ai/
# 2. Execute: ollama pull mistral-small3.1:24b
# 3. Use DEFAULT_LLM_PROVIDER=ollama

# ===== CONFIGURAÇÕES AVANÇADAS =====
AI_TIMEOUT=30
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.1
AI_FALLBACK_ENABLED=true

# ===== FUNCIONALIDADES ESPECÍFICAS =====
# Transcrição de áudio/vídeo (requer OpenAI)
WHISPER_ENABLED=true

# Análise de imagens (requer OpenAI GPT-4V ou Google Gemini Pro Vision)
VISION_ENABLED=true

# Chat com dados do paciente
CHAT_ENABLED=true

# Import/Export inteligente
SMART_IMPORT_ENABLED=true
