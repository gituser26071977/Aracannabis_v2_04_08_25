# Flask Configuration for Production (Hostinger)
FLASK_ENV=production
FLASK_APP=app.py

# Database Configuration (Hostinger PostgreSQL)
# Substitua pelos dados reais da sua conta Hostinger
DATABASE_URL=postgresql://seu_usuario:sua_senha@seu_hostname:5432/aracannabis_prod

# Security Keys (GERAR NOVAS CHAVES SEGURAS PARA PRODUÇÃO!)
# Use: python -c "import secrets; print(secrets.token_hex(32))" para gerar
JWT_SECRET_KEY=REDACTED
SECRET_KEY=REDACTED

# Debug Mode (SEMPRE False em produção)
DEBUG=False

# AI Features (false para versão básica, true para versão com IA)
AI_ENABLED=false

# Email Configuration (Hostinger SMTP)
SMTP_SERVER=smtp.hostinger.com
SMTP_PORT=465
EMAIL_USER=aracannabis@agentesinteligentes.pro
EMAIL_PASSWORD=sua_senha_email_hostinger

# WhatsApp Configuration (Opcional)
WHATSAPP_API_URL=https://api.twilio.com/2010-04-01/Accounts/YOUR_SID/Messages.json
WHATSAPP_TOKEN=your_whatsapp_api_token_here

# Configurações de Produção
PORT=5000
WORKERS=4

# Configurações de Segurança Adicionais
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Configurações de CORS para Produção
CORS_ORIGINS=https://seu-dominio.com,https://www.seu-dominio.com

# Configurações de Rate Limiting para Produção
RATELIMIT_STORAGE_URL=redis://localhost:6379/0

# Configurações de Log
LOG_LEVEL=INFO
LOG_FILE=/var/log/aracannabis/app.log

# Configurações de Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Todo dia às 2h da manhã
BACKUP_RETENTION_DAYS=30

# Monitoramento
SENTRY_DSN=https://your-sentry-dsn-here
MONITORING_ENABLED=true

# Configurações específicas da Hostinger
HOSTINGER_DOMAIN=seu-dominio.com
HOSTINGER_SUBDOMAIN=aracannabis.seu-dominio.com
