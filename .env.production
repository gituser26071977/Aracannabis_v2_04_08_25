# Aracannabis SIAP - Configuração de Produção
FLASK_APP=app.py
FLASK_ENV=production
DEBUG=False
SECRET_KEY=REDACTED

# Banco de Dados (Docker Interno)
POSTGRES_DB=aracannabis
POSTGRES_USER=siap_user
POSTGRES_PASSWORD=definir_senha_forte_no_vps

# URLs e Domínios
FRONTEND_BASE_URL=https://aracannabis.com.br
API_BASE_URL=https://api.aracannabis.com.br
CORS_ORIGINS=https://aracannabis.com.br,https://www.aracannabis.com.br

# AI / LLM - Provedores Padrão
DEFAULT_LLM_PROVIDER=maritaca
DEFAULT_LLM_MODEL=sabiazinho-4
DEFAULT_LLM_VISION_PROVIDER=google
DEFAULT_LLM_VISION_MODEL=gemini-1.5-flash

# Chaves de API (Placeholders - Preencher no VPS)
MARITACA_API_KEY=
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (Host Hostinger)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Pagamentos
MERCADOPAGO_ACCESS_TOKEN=

# Anonimização
ANONYMIZATION_KEY=chave_secreta_anonimizacao
ANONYMIZATION_AUDIT_MODEL=qwen3:1.7b
